    "context": "demo-org-tiny"
  }
}


### 1.5 — Submit m5: Stadt Osnabrück, Zentrale (JW~0.89 vs m2, extends DEU cluster)
# @name m5_resolve
POST {{ers_api_url}}/api/{{api_version}}/resolve HTTP/1.1
Content-Type: application/json
