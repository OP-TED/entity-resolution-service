    epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open> ;
    epo:hasProcurementScopeDividedIntoLot epd:id_2023-S-210-663262_Lot_DgNm7RuiSQ47VBTvdrHsRv ;
    epo:hasPurpose epd:id_2023-S-210-663262_ProcedurePurpose_faF7Q5dyoGpXu3Ru4RGg73 ;
    epo:hasTitle "Rámcová dohoda na výkon stavebního dozoru a koordinátora BOZP pro malé stavby-2022"@cs ;
    epo:isCoveredByGPA true ;
